---
import '../styles/global.css';

const acessos = [
  { icone: '📅', titulo: 'Calendário escolar', texto: 'Datas, períodos e organização do ano letivo.', href: 'https://escolaieda.com/calendario.html' },
  { icone: '🗂️', titulo: 'Arquivo Digital', texto: 'Acesso aos documentos e serviços administrativos.', href: 'https://escolaieda.com/arquivo-digital/' },
  { icone: '👩‍🏫', titulo: 'Professores', texto: 'Informações e espaços destinados à equipe docente.', href: 'https://escolaieda.com/professor/' },
  { icone: '🎓', titulo: 'Alunos', texto: 'Acessos e informações para estudantes.', href: 'https://escolaieda.com/aluno/' },
];

const numeros = [
  { valor: '1990', rotulo: 'Fundação' },
  { valor: '6º ao 9º', rotulo: 'Ensino Fundamental — Anos Finais' },
  { valor: '19', rotulo: 'Professores' },
  { valor: '45', rotulo: 'Funcionários' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Escola Municipal Professora Iêda Alves de Oliveira MCPM — educação, compromisso e formação cidadã em Medeiros Neto, Bahia." />
    <meta name="theme-color" content="#062f5d" />
    <title>Escola Municipal Professora Iêda Alves de Oliveira MCPM</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#inicio" aria-label="Página inicial da Escola Iêda">
          <img src="/logo-escola.webp" alt="Logomarca da Escola Municipal Professora Iêda Alves de Oliveira MCPM" />
          <span>
            <strong>Escola Iêda</strong>
            <small>MCPM • Medeiros Neto — BA</small>
          </span>
        </a>
        <nav class="main-nav" aria-label="Navegação principal">
          <a href="#escola">A escola</a>
          <a href="#acessos">Acessos</a>
          <a href="#informacoes">Informações</a>
          <a href="#contato">Contato</a>
        </nav>
        <a class="admin-link" href="https://escolaieda.com/admin/">Centro de Administração</a>
      </div>
    </header>

    <main id="inicio">
      <section class="hero">
        <div class="hero-glow hero-glow-one"></div>
        <div class="hero-glow hero-glow-two"></div>
        <div class="container hero-grid">
          <div class="hero-copy">
            <span class="eyebrow">Educação pública • Formação cidadã</span>
            <h1>Uma escola conectada com o presente e comprometida com o futuro.</h1>
            <p>Educação, compromisso e formação cidadã em Medeiros Neto — Bahia. Um portal mais simples para aproximar estudantes, famílias, profissionais e comunidade escolar.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#acessos">Acessos rápidos</a>
              <a class="button button-secondary" href="#escola">Conheça a escola</a>
            </div>
            <div class="hero-note">
              <span class="pulse"></span>
              Portal institucional em evolução contínua
            </div>
          </div>
          <div class="hero-visual" aria-label="Identidade visual da Escola Iêda">
            <div class="logo-shell">
              <img src="/logo-escola.webp" alt="" aria-hidden="true" />
            </div>
            <div class="floating-card card-top">
              <span>📍</span>
              <div><strong>Medeiros Neto</strong><small>Bahia</small></div>
            </div>
            <div class="floating-card card-bottom">
              <span>🏫</span>
              <div><strong>6º ao 9º ano</strong><small>Ensino Fundamental</small></div>
            </div>
          </div>
        </div>
      </section>

      <section class="quick-section" id="acessos">
        <div class="container">
          <div class="section-heading compact-heading">
            <div><span class="section-kicker">Resolva rápido</span><h2>Acessos principais</h2></div>
            <p>Os serviços mais procurados da escola, organizados em um único lugar.</p>
          </div>
          <div class="quick-grid">
            {acessos.map((item) => (
              <a class="quick-card" href={item.href}>
                <span class="quick-icon" aria-hidden="true">{item.icone}</span>
                <div><h3>{item.titulo}</h3><p>{item.texto}</p></div>
                <span class="quick-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="notice-wrap" id="informacoes">
        <div class="container">
          <div class="notice-card">
            <div class="notice-icon" aria-hidden="true">✦</div>
            <div>
              <span class="section-kicker">Informação centralizada</span>
              <h2>Menos procura, mais clareza.</h2>
              <p>Este novo portal está sendo pensado para concentrar avisos, documentos, calendário, notícias e acessos administrativos sem exigir que o usuário conheça a estrutura interna dos sistemas da escola.</p>
            </div>
            <a href="#contato">Ver canais de atendimento <span>→</span></a>
          </div>
        </div>
      </section>

      <section class="school-section" id="escola">
        <div class="container school-grid">
          <div class="school-copy">
            <span class="section-kicker">Nossa Escola</span>
            <h2>Aprendizagem, acolhimento e participação.</h2>
            <p>Um espaço comprometido com o desenvolvimento dos estudantes e com a participação da comunidade escolar.</p>
            <p>Nossa missão é contribuir para uma educação de qualidade, fortalecendo valores, conhecimento e responsabilidade social em cada etapa da formação do estudante.</p>
            <a class="text-link" href="https://escolaieda.com/institucional/">Conheça nossa história <span>→</span></a>
          </div>
          <div class="stats-panel">
            {numeros.map((item) => (
              <div class="stat-item"><strong>{item.valor}</strong><span>{item.rotulo}</span></div>
            ))}
          </div>
        </div>
      </section>

      <section class="feature-section">
        <div class="container feature-grid">
          <article class="feature-card calendar-card">
            <div class="feature-image"><img src="/calendario.jpg" alt="Calendário escolar" /></div>
            <div class="feature-content">
              <span class="section-kicker">Organização</span>
              <h3>Calendário escolar</h3>
              <p>Consulte datas e períodos importantes para acompanhar o ano letivo.</p>
              <a href="https://escolaieda.com/calendario.html">Abrir calendário <span>→</span></a>
            </div>
          </article>
          <article class="feature-card archive-card">
            <div class="feature-content archive-content">
              <div class="archive-logo"><img src="/arquivo-digital-logo.png" alt="Arquivo Digital" /></div>
              <span class="section-kicker">Secretaria digital</span>
              <h3>Documentos no lugar certo.</h3>
              <p>Acesse o Arquivo Digital e os serviços administrativos disponíveis para a equipe.</p>
              <a href="https://escolaieda.com/arquivo-digital/">Acessar Arquivo Digital <span>→</span></a>
            </div>
          </article>
        </div>
      </section>

      <section class="future-section">
        <div class="container future-inner">
          <div>
            <span class="section-kicker light">Próximas etapas</span>
            <h2>Um portal preparado para crescer sem ficar complicado.</h2>
          </div>
          <div class="future-list">
            <span>Notícias</span><span>Avisos</span><span>Galerias</span><span>Eventos</span><span>Documentos</span><span>Equipe</span>
          </div>
        </div>
      </section>
    </main>

    <footer id="contato" class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <img src="/logo-escola.webp" alt="" aria-hidden="true" />
          <div><strong>Escola Municipal Professora Iêda Alves de Oliveira MCPM</strong><p>Medeiros Neto — Bahia</p></div>
        </div>
        <div><span class="footer-label">Portal</span><a href="#escola">Nossa Escola</a><a href="#acessos">Acessos rápidos</a><a href="https://escolaieda.com/calendario.html">Calendário</a></div>
        <div><span class="footer-label">Administração</span><a href="https://escolaieda.com/admin/">Centro de Administração</a><a href="https://escolaieda.com/arquivo-digital/">Arquivo Digital</a></div>
      </div>
      <div class="container footer-bottom"><span>Portal institucional da Escola Iêda</span><span>Educação • Compromisso • Cidadania</span></div>
    </footer>
  </body>
</html>
