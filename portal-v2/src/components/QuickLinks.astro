---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  items: any[];
}

const { items } = Astro.props;
---

<section class="quick-section" id="acessos">
  <div class="container">
    <div class="section-heading compact-heading" data-reveal="up">
      <div><span class="section-kicker">Encontre rapidamente</span><h2>Acessos principais</h2></div>
      <p>Os pontos mais úteis da página, sem repetir caminhos ou serviços.</p>
    </div>

    <div class="quick-grid">
      {items.map((item, index) => (
        <a class="quick-card" href={item.href} data-tina-field={tinaField(item)} data-reveal="up" style={`--delay:${index * 80}ms`}>
          <span class="quick-icon" aria-hidden="true">{item.icon}</span>
          <div>
            <h3 data-tina-field={tinaField(item, 'title')}>{item.title}</h3>
            <p data-tina-field={tinaField(item, 'description')}>{item.description}</p>
          </div>
          <span class="quick-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
