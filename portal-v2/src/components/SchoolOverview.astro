---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  content: any;
}

type StatItem = {
  value?: string | null;
  label?: string | null;
};

const { content } = Astro.props;
const paragraphs = (content.paragraphs ?? []).filter(Boolean) as string[];
const stats = (content.stats ?? []).filter(Boolean) as StatItem[];
---

<section class="school-section" id="escola">
  <div class="container school-grid">
    <div class="school-copy" data-reveal="left">
      <span class="section-kicker" data-tina-field={tinaField(content, 'kicker')}>{content.kicker}</span>
      <h2 data-tina-field={tinaField(content, 'title')}>{content.title}</h2>
      {paragraphs.map((paragraph, index) => (
        <p data-tina-field={tinaField(content, 'paragraphs', index)}>{paragraph}</p>
      ))}
    </div>
    <div class="stats-panel" data-reveal="right">
      {stats.map((item, index) => (
        <div class="stat-item" data-tina-field={tinaField(item)} style={`--delay:${index * 90}ms`}>
          <strong data-tina-field={tinaField(item, 'value')}>{item.value}</strong>
          <span data-tina-field={tinaField(item, 'label')}>{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
