---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#inicio" aria-label="Página inicial da Escola Iêda">
      <img src={`${base}logo-escola.webp`} alt="Logomarca da Escola Municipal Professora Iêda Alves de Oliveira MCPM" />
      <span>
        <strong>Escola Iêda</strong>
        <small>MCPM • Medeiros Neto — BA</small>
      </span>
    </a>
    <nav class="main-nav" aria-label="Navegação principal">
      <a href="#escola">A escola</a>
      <a href="#acessos">Acessos</a>
      <a href="#informacoes">Informações</a>
      <a href="#contato">Contato</a>
    </nav>
  </div>
</header>
