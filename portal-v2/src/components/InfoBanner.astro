---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  content: any;
}

const { content } = Astro.props;
---

<section class="notice-wrap" id="informacoes">
  <div class="container">
    <div class="notice-card" data-reveal="scale">
      <div class="notice-icon" aria-hidden="true">✦</div>
      <div>
        <span class="section-kicker" data-tina-field={tinaField(content, 'kicker')}>{content.kicker}</span>
        <h2 data-tina-field={tinaField(content, 'title')}>{content.title}</h2>
        <p data-tina-field={tinaField(content, 'description')}>{content.description}</p>
      </div>
    </div>
  </div>
</section>
