---
interface Props {
  content: {
    kicker: string;
    title: string;
    description: string;
  };
}

const { content } = Astro.props;
---

<section class="notice-wrap" id="informacoes">
  <div class="container">
    <div class="notice-card" data-reveal="scale">
      <div class="notice-icon" aria-hidden="true">✦</div>
      <div>
        <span class="section-kicker">{content.kicker}</span>
        <h2>{content.title}</h2>
        <p>{content.description}</p>
      </div>
    </div>
  </div>
</section>
