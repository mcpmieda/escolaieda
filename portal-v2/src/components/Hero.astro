---
interface Props {
  content: {
    eyebrow: string;
    title: string;
    description: string;
    location: string;
    state: string;
    grade: string;
    gradeLabel: string;
  };
}

const { content } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="hero">
  <div class="hero-glow hero-glow-one" data-parallax="0.08"></div>
  <div class="hero-glow hero-glow-two" data-parallax="-0.05"></div>
  <div class="hero-orbit orbit-one" aria-hidden="true"></div>
  <div class="hero-orbit orbit-two" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy" data-reveal="left">
      <span class="eyebrow">{content.eyebrow}</span>
      <h1>{content.title}</h1>
      <p>{content.description}</p>
    </div>
    <div class="hero-visual" data-reveal="right" aria-label="Identidade visual da Escola Iêda">
      <div class="logo-shell" data-parallax="0.035">
        <img src={`${base}logo-escola.webp`} alt="" aria-hidden="true" />
      </div>
      <div class="floating-card card-top float-slow">
        <span aria-hidden="true">📍</span>
        <div><strong>{content.location}</strong><small>{content.state}</small></div>
      </div>
      <div class="floating-card card-bottom float-reverse">
        <span aria-hidden="true">🏫</span>
        <div><strong>{content.grade}</strong><small>{content.gradeLabel}</small></div>
      </div>
    </div>
  </div>
</section>
