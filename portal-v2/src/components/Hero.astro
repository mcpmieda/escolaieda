---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
  content: any;
}

const { content } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="hero">
  <div class="hero-glow hero-glow-one" data-parallax="0.08"></div>
  <div class="hero-glow hero-glow-two" data-parallax="-0.05"></div>
  <div class="hero-orbit orbit-one" aria-hidden="true"></div>
  <div class="hero-orbit orbit-two" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy" data-reveal="left">
      <span class="eyebrow" data-tina-field={tinaField(content, 'eyebrow')}>{content.eyebrow}</span>
      <h1 data-tina-field={tinaField(content, 'title')}>{content.title}</h1>
      <p data-tina-field={tinaField(content, 'description')}>{content.description}</p>
    </div>
    <div class="hero-visual" data-reveal="right" aria-label="Identidade visual da Escola Iêda">
      <div class="logo-shell" data-parallax="0.035">
        <img src={`${base}logo-escola.webp`} alt="" aria-hidden="true" />
      </div>
      <div class="floating-card card-top float-slow">
        <span aria-hidden="true">📍</span>
        <div>
          <strong data-tina-field={tinaField(content, 'location')}>{content.location}</strong>
          <small data-tina-field={tinaField(content, 'state')}>{content.state}</small>
        </div>
      </div>
      <div class="floating-card card-bottom float-reverse">
        <span aria-hidden="true">🏫</span>
        <div>
          <strong data-tina-field={tinaField(content, 'grade')}>{content.grade}</strong>
          <small data-tina-field={tinaField(content, 'gradeLabel')}>{content.gradeLabel}</small>
        </div>
      </div>
    </div>
  </div>
</section>
